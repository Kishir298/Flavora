# Copy to .env for local dev. Never commit .env.
NODE_ENV=development
PORT=4000
# Frontend -> backend URL (Vite exposes VITE_ prefixed vars to client)
VITE_API_URL=http://localhost:4000

# Recipe data lives in the local SQLite DB, seeded from /data/*.json.
# Core recommendations never need a network call.

# SQLite file (Prisma). Resolved relative to prisma/ dir. Keep on disk, never commit (*.db is gitignored).
# Use an absolute path or file:../prisma/dev.db from repo root tooling to avoid CWD ambiguity.
DATABASE_URL="file:../prisma/dev.db"

# Flavora is local-only: natural-language requests are parsed by the built-in
# FlavoraLM model (or the deterministic local parser as honest fallback).
# There is no remote AI provider and no API key. Recommendations always run locally.

# ---------------------------------------------------------------------------
# FlavoraLM — our own small language model, trained for Flavora.
# Runs entirely on this machine via training/flavora_lm/service.py
# (default http://127.0.0.1:5000) — no request data leaves it, no downloads.
# `npm run start` launches the service automatically. All hosts must be local.
# FLAVORA_LM_ENABLED=true
# FLAVORA_LM_HOST=http://127.0.0.1:5000
# FLAVORA_LM_PORT=5000
# FLAVORA_LM_MODEL=FlavoraLM
# FLAVORA_LM_TIMEOUT_MS=30000
# FLAVORA_LM_ENGINE=torch
# Legacy LOCAL_LLM_* names still work as fallback.
# LOCAL_LLM_ENABLED=true
# LOCAL_LLM_HOST=http://127.0.0.1:5000
# LOCAL_LLM_MODEL=FlavoraLM
# LOCAL_LLM_TIMEOUT_MS=30000

# Provider selection: local | heuristic (default local).
# local      = FlavoraLM only; explicit fallback notice if it is not running
# heuristic  = deterministic local parsing, no LLM at all
# AI_PROVIDER=local

# Dev/debug routes (POST /api/dev/seed|reset, GET /api/debug/explain):
# require non-production AND (loopback OR this flag). Never enable in prod.
# ENABLE_DEV_ROUTES=0

# Local-first debug + setup flags (server-side only):
# FLAVORA_DEBUG_CONVERSATION=0
# FLAVORA_NO_OPEN=0
# FLAVORA_SETUP_ONLY=0
# API_URL=http://127.0.0.1:4000
# FLAVORA_USER_DATA_FILE=data/user-data.json
# FLAVORA_NUTRITION_CACHE=data/nutrition-cache.json
# FLAVORA_DEBUG=0

# Optional nutrition enrichment (server-side only, never VITE_*).
# Authored recipe data is always primary; this only fills gaps for new
# ingredient lookups (cached locally, offline-safe afterwards).
# USDA FoodData Central key (free, CC0 data): https://fdc.nal.usda.gov/api-guide
# USDA_FDC_API_KEY=
# Open Food Facts needs no key (ODbL, attributed in README/UI).
