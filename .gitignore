# Deps
node_modules/
.pnp
.pnp.js

# Env / secrets (USDA_FDC_API_KEY lives here, never commit)
.env
.env.local
.env.*.local
.env.*
!.env.example

# TLS / key material (never commit even if dropped here by tooling)
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer

# SQLite local data (holds real user data even in dev)
*.db
*.db-journal
*.sqlite
*.sqlite-journal
prisma/dev.db
prisma/*.db

# Local JSON user-data store (real user meals/goals; recreated on launch)
data/user-data.json
data/user-data.json.corrupt-*.bak
# Local nutrition cache (server-side USDA/OFF lookups; recreated on demand)
data/nutrition-cache.json

# Build output
dist/
build/
.vite/
.next/
out/
*.tsbuildinfo
*.tsbuildinfo.*

# Logs / OS
logs/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Test / coverage
coverage/
playwright-report/
test-results/

# Misc
.vscode/*
!.vscode/extensions.json
.idea/

# Python learning-layer venv (optional local install)
server/src/engine/.venv/
# FlavoraLM local virtualenv (recreated by `npm run setup`, ~500 MB with torch)
.flavoralm-venv/
**/__pycache__/
*.pyc
# FlavoraLM dev-model outputs (fast-test only; `npm run train:llm:dev` regenerates).
# The v0.1/ production release IS committed — never ignore it.
# training_state.pt is a 57M resume checkpoint — intentionally untracked, never commit.
models/flavora-lm/v0.1/training_state.pt
**/training_state.pt
models/flavora-lm/dev/
# NumPy v0.2 sidecar checkpoint IS committed alongside v0.1 (412 KB);
# regenerate via `npm run train:llm-numpy`.
# Eval reports are machine-specific (ms timings) — regenerate via
# `npm run evaluate:llm:sample` (25 ex, minutes) or `npm run evaluate:llm`
# (full set, hours); never commit timing-laden reports.
models/flavora-lm/v0.1/eval.json
models/flavora-lm/dev/eval.json
# Resumable-eval checkpoints + per-run result bundles (see training/evaluate.py
# --checkpoint/--out and `npm run eval:slow`; recreated on every run).
models/flavora-lm/v0.1/eval-checkpoint.jsonl
models/flavora-lm/dev/eval-checkpoint.jsonl
eval-results/
playwright-eval-results/
dev-dist/
