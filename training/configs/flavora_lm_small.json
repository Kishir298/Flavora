{
  "model_name": "FlavoraLM",
  "version": "0.1",
  "architecture": "decoder_transformer",
  "vocab_size": 4096,
  "context_length": 256,
  "embedding_dim": 256,
  "layers": 6,
  "attention_heads": 8,
  "feed_forward_dim": 1024,
  "dropout": 0.1,
  "training": {
    "epochs": 12,
    "batch_size": 32,
    "learning_rate": 0.0006,
    "warmup_steps": 100,
    "grad_clip": 1.0,
    "seed": 42
  },
  "tokenizer": {
    "vocab_size": 4096
  },
  "dataset": {
    "train_examples": 12000,
    "validation_examples": 1200,
    "test_examples": 1000,
    "seed": 42
  }
}
