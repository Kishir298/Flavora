generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton row (id = 1) — single-user local app, no accounts.
model UserProfile {
  id            Int     @id @default(1)
  allergies     String  @default("[]") // JSON string[]
  avoidFoods    String  @default("[]") // JSON string[]
  cuisines      String  @default("[]") // JSON string[]
  spice         String  @default("medium") // mild | medium | hot
  skill         String  @default("beginner") // beginner | intermediate | advanced
  nutritionGoals String @default("{}") // JSON e.g. {"highProtein":true,"lowCarb":false,"maxCalories":600}
  maxCookTime   Int     @default(30)
  theme         String  @default("light") // light | dark
  updatedAt     DateTime @updatedAt
}

model RecipeCache {
  id          String   @id // e.g. "spoonacular:716429" or "mock:1"
  source      String   // spoonacular | themealdb | mock
  title       String
  cuisine     String   @default("")
  cookTime    Int      @default(30)
  nutrition   String   @default("{}") // JSON {calories, protein, carbs, fat}
  ingredients String   @default("[]") // JSON string[]
  instructions String  @default("[]") // JSON string[]
  image       String   @default("")
  pricePerServing Float? // Spoonacular price; drives budget_fit when mode:"budget"
  fetchedAt   DateTime @default(now())
}

model Interaction {
  id        Int      @id @default(autoincrement())
  recipeId  String
  // shown | viewed | saved | cooked | rated_positive | rated_negative | skipped
  // (legacy "rated" also accepted as alias for rated_positive)
  action    String
  rating    Int?
  // Guide step 7: feature vector recorded when the recipe was shown
  // (JSON of the 6 engine features). Empty for user-initiated actions;
  // retrain joins labels to the latest "shown" row per recipe.
  features  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([recipeId])
  @@index([action])
}

// Single-user local app: user_id is always "local" (no accounts, per §10).
// Seeded with guide step-3 defaults on profile creation so scorer never
// sees a missing-weights case. Learning layer upserts per-feature rows.
model RecommendationWeights {
  userId      String   @default("local")
  featureName String
  weightValue Float
  updatedAt   DateTime @updatedAt

  @@id([userId, featureName])
}
