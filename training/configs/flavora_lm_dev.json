{
  "model_name": "FlavoraLM-dev",
  "version": "0.1",
  "architecture": "decoder_transformer",
  "vocab_size": 768,
  "context_length": 160,
  "embedding_dim": 128,
  "layers": 4,
  "attention_heads": 4,
  "feed_forward_dim": 512,
  "dropout": 0.1,
  "training": {
    "epochs": 120,
    "batch_size": 8,
    "learning_rate": 0.005,
    "warmup_steps": 100,
    "grad_clip": 1.0,
    "seed": 42
  },
  "tokenizer": {
    "vocab_size": 768
  },
  "dataset": {
    "train_examples": 1200,
    "validation_examples": 150,
    "test_examples": 150,
    "seed": 42
  }
}
