# Copy to .env for local dev. Never commit .env.
NODE_ENV=development
PORT=4000
# Frontend -> backend URL (Vite exposes VITE_ prefixed vars to client)
VITE_API_URL=http://localhost:4000

# Recipe data lives in the local SQLite DB, seeded from /data/*.json.
# Core recommendations never need a network call.

# SQLite file (Prisma). Keep on disk, never commit (*.db is gitignored).
DATABASE_URL="file:./dev.db"

# Optional conversational AI (server-side only). Leave blank to use local
# FlavoraLM / heuristic intent parsing — recommendations still work fully offline.
# Never put GROQ_API_KEY in VITE_* vars or client code.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# FlavoraLM — our own small language model, trained for Flavora.
# Runs entirely on this machine via training/flavora_lm/service.py
# (default http://127.0.0.1:5000) — no request data leaves it, no downloads.
# `npm run start` launches the service automatically. All hosts must be local.
# FLAVORA_LM_ENABLED=true
# FLAVORA_LM_HOST=http://127.0.0.1:5000
# FLAVORA_LM_MODEL=FlavoraLM
# FLAVORA_LM_TIMEOUT_MS=30000
# Legacy LOCAL_LLM_* names still work as fallback.

# Provider selection: auto | local | groq | heuristic (default auto).
# auto       = FlavoraLM (if running) -> Groq (if key set) -> heuristic
# local      = FlavoraLM only; explicit error if it is not running
# groq       = Groq only; heuristic fallback if the call fails
# heuristic  = deterministic local parsing, no LLM at all
# AI_PROVIDER=auto
