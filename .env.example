# Copy to .env for local dev. Never commit .env.
NODE_ENV=development
PORT=4000
# Frontend -> backend URL (Vite exposes VITE_ prefixed vars to client)
VITE_API_URL=http://localhost:4000

# Recipe data: mock (default, no key, zero quota) vs live
# true = use local fixtures + TheMealDB fallback; false = call Spoonacular
USE_MOCK_RECIPES=true

# Get a key at https://spoonacular.com/food-api (direct signup, no credit card).
# Free tier ~150 points/day. Only needed when USE_MOCK_RECIPES=false.
SPOONACULAR_API_KEY=

# SQLite file (Prisma). Keep on disk, never commit (*.db is gitignored).
DATABASE_URL="file:./dev.db"
